# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Google Calendar API (Service Account)
GOOGLE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID="your-calendar-id@gmail.com"

# Resend Email Configuration
RESEND_API_KEY="re_your_api_key"

# Mailbox (Titan) used to send emails to leads (SMTP) and receive replies (IMAP)
EMAIL_PASSWORD="YOUR_MAILBOX_PASSWORD"

# Shared secret between /api/emails/send and /api/jobs/email-worker.
# Required: without it, sending emails fails. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET="YOUR_RANDOM_SECRET"

# Public URL of the app (used to call the worker and in email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Port for the custom server (server.js). Optional, defaults to 3000
PORT=3000
